# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL='text-embedding-3-small'
OPENAI_CHAT_MODEL='gpt-4o-mini'

# Google Gemini (opcional — só se for usar Gemini como provedor)
# GOOGLE_API_KEY=
# GOOGLE_EMBEDDING_MODEL='models/embedding-001'

# Banco de dados (valores definidos no docker-compose.yml)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rag

# LangChain PGVector
PG_VECTOR_COLLECTION_NAME=document_collection

# PDF para ingestão (caminho relativo à raiz do projeto)
PDF_PATH=document.pdf

# Redes corporativas com inspeção TLS podem exigir um bundle de CAs próprio
# (bundle PEM contendo a CA da organização) — descomente e ajuste se necessário:
# SSL_CERT_FILE=/caminho/para/ca-bundle.pem
